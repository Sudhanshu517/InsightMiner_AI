# ============================================================
# InsightMiner AI — Environment Variables Template
# ============================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# Then fill in your own values. Never commit .env.local to git.
# ============================================================


# ------------------------------------------------------------
# REQUIRED — MongoDB connection string
# ------------------------------------------------------------
# Get from: https://cloud.mongodb.com → your cluster → Connect
# Free tier: M0 cluster (no credit card required)
# Format:    mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# ------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/


# ------------------------------------------------------------
# REQUIRED — NextAuth JWT signing secret
# ------------------------------------------------------------
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# or (PowerShell):
#   [System.Convert]::ToBase64String((1..32 | ForEach-Object { [byte](Get-Random -Maximum 256) }))
# Use a different value in production than in local development.
# ------------------------------------------------------------
NEXTAUTH_SECRET=


# ------------------------------------------------------------
# REQUIRED in production (non-Vercel hosts only)
# ------------------------------------------------------------
# Set to your deployed URL so NextAuth can resolve callback URLs.
# Vercel auto-detects this — leave blank or omit when deploying to Vercel.
# Local development: Next.js auto-detects http://localhost:3000
# Example: https://your-app.up.railway.app
# ------------------------------------------------------------
# NEXTAUTH_URL=


# ------------------------------------------------------------
# OPTIONAL — Groq API key (AI-enriched analysis)
# ------------------------------------------------------------
# Without this the app runs in Demo Mode: sentiment is scored
# by the local model and a pre-written response is returned.
# Get a free key at: https://console.groq.com
# Model used: llama-3.3-70b-versatile
# ------------------------------------------------------------
GROQ_API_KEY=
